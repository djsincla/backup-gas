{
  "manifest_version": 3,
  "name": "BackupGAS",
  "version": "1.2.0",
  "description": "Save every file of the Apps Script project open in the editor to Google Drive or your computer, including scripts attached to Sheets, Docs and Forms.",
  "permissions": ["scripting", "downloads", "storage"],
  "host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Export this Apps Script project",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
